<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides"
           xsi:type="MailApp">
  <Id>6f2b7c1e-4a39-4d8e-9b15-3c7e0a5d2f84</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Excommunicado</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Excommunicado"/>
  <Description DefaultValue="Scores how much corporate bullshit a mail contains. Runs on your own PC.">
    <Override Locale="sv-SE" Value="Betygsätter hur mycket företagsbullshit ett mejl innehåller. Körs på din egen dator."/>
  </Description>
  <IconUrl DefaultValue="https://localhost:47823/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:47823/icon-128.png"/>
  <SupportUrl DefaultValue="https://localhost:47823/taskpane.html"/>
  <AppDomains>
    <AppDomain>https://localhost:47823</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Mailbox"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:47823/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="excomGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="excomOpen">
                    <Label resid="buttonLabel"/>
                    <Supertip>
                      <Title resid="buttonLabel"/>
                      <Description resid="buttonTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="paneUrl"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://localhost:47823/icon-16.png"/>
          <bt:Image id="icon32" DefaultValue="https://localhost:47823/icon-32.png"/>
          <bt:Image id="icon80" DefaultValue="https://localhost:47823/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="paneUrl" DefaultValue="https://localhost:47823/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="Excommunicado"/>
          <bt:String id="buttonLabel" DefaultValue="Bullshit score">
            <bt:Override Locale="sv-SE" Value="Bullshit-betyg"/>
          </bt:String>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="buttonTip" DefaultValue="Score this mail for corporate bullshit. The mail stays on your PC.">
            <bt:Override Locale="sv-SE" Value="Betygsätt mejlet. Mejlet lämnar inte din dator."/>
          </bt:String>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
